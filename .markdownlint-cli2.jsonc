{
	// Regras: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
	"config": {
		"default": true,
		// Documentação técnica com tabelas e URLs longas: sem limite de largura de linha.
		"MD013": false,
		// O README usa HTML para o cabeçalho centralizado e os badges.
		"MD033": { "allowed_elements": ["h1", "p", "a", "img", "br", "details", "summary"] },
		"MD041": false,
		// O bloco que o `next dev` reescreve em AGENTS.md/CLAUDE.md traz um segundo título de nível 1.
		"MD025": false,
		// O changelog (Keep a Changelog) repete "Added", "Fixed" etc. em cada versão.
		"MD024": { "siblings_only": true }
	},
	"globs": ["*.md", "docs/**/*.md", ".github/**/*.md"],
	"ignores": ["node_modules", ".claude", "graphify-out", ".next"]
}
