  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint:next": "next lint",
    "lint": "biome check app/ --fix --unsafe",
    "format": "biome format app/ lib/ hooks/ contexts/ components/ prisma/ emails/ actions/ types/ --fix",
    "prepare": "husky",
    "prisma:generate:no-engine": "bunx prisma generate --no-engine",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:studio": "bunx prisma studio",
    "prisma:db:seed": "bunx prisma db seed",
    "prisma:migrate:reset": "bunx prisma migrate reset"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,json,jsonc}": [
      "biome check --apply --no-errors-on-unmatched"
    ]
  },
