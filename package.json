{
  "name": "respondeae.com.br",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && next build",
    "vercel-build": "bash infra/vercel-build.sh",
    "start": "next start",
    "lint": "biome check app/ lib/ hooks/ contexts/ components/ prisma/ emails/ actions/ types/ tests/ providers/ *.ts *.json --fix",
    "lint:unsafe": "biome check app/ lib/ hooks/ contexts/ components/ prisma/ emails/ actions/ types/ tests/ providers/ *.ts *.json --fix --unsafe",
    "lint:ci": "biome check --error-on-warnings app/ lib/ hooks/ contexts/ components/ prisma/ emails/ actions/ types/ tests/ providers/ *.ts *.json",
    "format": "biome format app/ lib/ hooks/ contexts/ components/ prisma/ emails/ actions/ types/ tests/ *.ts *.json --fix",
    "format:ci": "biome format app/ lib/ hooks/ contexts/ components/ prisma/ emails/ actions/ types/ tests/ *.ts *.json",
    "prepare": "husky",
    "test": "bun test lib/ hooks/",
    "test:unit": "bun test lib/",
    "test:integration": "bun test tests/integration --timeout 20000",
    "test:smoke": "bun test tests/smoke --timeout 30000",
    "test:e2e": "playwright test",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:studio": "bunx prisma studio",
    "prisma:db:seed": "bunx prisma db seed",
    "prisma:migrate:reset": "bunx prisma migrate reset"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-avatar": "1.2.7",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-progress": "1.1.17",
    "@radix-ui/react-radio-group": "1.4.8",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-toast": "1.2.24",
    "@react-email/components": "1.0.12",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@uploadthing/react": "7.3.3",
    "@vercel/speed-insights": "2.0.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cpf-cnpj-validator": "2.1.2",
    "date-fns": "4.4.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "resend": "6.32.1",
    "slugify": "1.6.9",
    "sonner": "2.0.8",
    "stripe": "22.6.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "uploadthing": "7.7.4",
    "uuid": "14.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.0",
    "@tailwindcss/typography": "0.5.20",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.3",
    "dotenv": "18.0.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.29",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "effect": "3.22.2",
    "baseline-browser-mapping": "2.11.26",
    "mysql2": "3.24.4"
  }
}
