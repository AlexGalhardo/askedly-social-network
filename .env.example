NODE_ENV=development

# Essential (the build fails without them, see lib/env.ts): DATABASE_URL, NEXTAUTH_SECRET, NEXTAUTH_URL, NEXT_PUBLIC_APP_URL.
# All the others are optional: when missing, the feature stays off and the build only warns.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
# Sender on a domain verified in Resend (e.g. "Askedly Social Network <no-reply@your-domain.com>"). Without it, only the Resend account owner receives emails.
RESEND_FROM_EMAIL=

# Server-only (no NEXT_PUBLIC_). API v2. Locally use the sandbox key (abc_dev_...) with NEXT_PUBLIC_TEST_MODE=true;
# in production, the real key with NEXT_PUBLIC_TEST_MODE=false.
ABACATEPAY_WEBHOOK_SECRET=ngroklocalhost
ABACATEPAY_API_KEY=

# Stripe (US dollar credits + Connect). Server-only. Prefer a restricted key (rk_...) with write access to Checkout Sessions,
# Transfers and Connect (Accounts v2 / Account Links). Webhook: /api/webhook/stripe (see docs/payments-stripe.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPLOADTHING_TOKEN=

# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_HTTP_TOKEN=
TELEGRAM_BOT_CHANNEL_ID=

# Postgres (production/dev). For local dev without Postgres use DATABASE_URL="file:./dev.db" (setups/*-sqlite.sh):
# prisma.config.ts and prisma/prisma-client.ts switch to the SQLite schema/adapter based on the `file:` prefix.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/askedly_db?schema=public"

SEED_TOTAL_RANDOM_USERS_TO_CREATED=1500
SEED_TOTAL_FOLLOWERS_RELATIONS=10000
SEED_RANDOM_QUESTIONS_TO_CREATE=100

NEXT_PUBLIC_TEST_MODE=true

DANGER_MODE=false

# Optional captcha: it only turns on with BOTH keys. Without them the widget disappears and the server does not require a token.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cronjob (vercel.json). Generate with: openssl rand -hex 32
CRON_SECRET=
