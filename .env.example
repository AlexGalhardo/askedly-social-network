NODE_ENV=development

# Essenciais (o build falha sem elas, ver lib/env.ts): DATABASE_URL, NEXTAUTH_SECRET, NEXTAUTH_URL, NEXT_PUBLIC_APP_URL.
# Todas as outras são opcionais: faltando, o recurso fica desligado e o build só avisa.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
# Remetente de domínio verificado na Resend (ex.: "Askedly Social Network <nao-responda@respondeae.com.br>"). Sem ele, só o dono da conta Resend recebe emails.
RESEND_FROM_EMAIL=

# Server-only (sem NEXT_PUBLIC_). API v2. Localmente use a chave sandbox (abc_dev_...) com NEXT_PUBLIC_TEST_MODE=true;
# em produção, a chave real com NEXT_PUBLIC_TEST_MODE=false.
ABACATEPAY_WEBHOOK_SECRET=ngroklocalhost
ABACATEPAY_API_KEY=

# Stripe (créditos em dólar + Connect). Server-only. Prefira chave restrita (rk_...) com escrita em Checkout Sessions,
# Transfers e Connect (Accounts v2 / Account Links). Webhook: /api/webhook/stripe (ver docs/payments-stripe.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPLOADTHING_TOKEN=

# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_HTTP_TOKEN=
TELEGRAM_BOT_CHANNEL_ID=

# Postgres (produção/dev). Para dev local sem Postgres use DATABASE_URL="file:./dev.db" (setups/*-sqlite.sh):
# prisma.config.ts e prisma/prisma-client.ts trocam para o schema/adapter SQLite pelo prefixo `file:`.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/askedly_db?schema=public"

SEED_TOTAL_RANDOM_USERS_TO_CREATED=1500
SEED_TOTAL_FOLLOWERS_RELATIONS=10000
SEED_RANDOM_QUESTIONS_TO_CREATE=100

NEXT_PUBLIC_TEST_MODE=true

DANGER_MODE=false

# Captcha opcional: só liga com as DUAS chaves. Sem elas o widget some e o servidor não exige token.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Vercel Cron manda `Authorization: Bearer $CRON_SECRET` para /api/cronjob (vercel.json). Gere com: openssl rand -hex 32
CRON_SECRET=
